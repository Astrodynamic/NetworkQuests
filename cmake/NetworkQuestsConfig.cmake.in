@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies
find_dependency(Threads)

# Optional dependencies
if(@ENABLE_BOOST@)
    find_dependency(Boost COMPONENTS system)
endif()

if(@ENABLE_OPENSSL@)
    find_dependency(OpenSSL)
endif()

# Include targets
include(${CMAKE_CURRENT_LIST_DIR}/NetworkQuestsTargets.cmake)

# Check required components
check_required_components(NetworkQuests)

# Set variables for users
set(NetworkQuests_VERSION @PROJECT_VERSION@)
set(NetworkQuests_INCLUDE_DIRS ${CMAKE_CURRENT_LIST_DIR}/../../../include)
set(NetworkQuests_LIBRARIES NetworkQuests::Core)

# Available protocols
set(NetworkQuests_PROTOCOLS 
    TCP 
    UDP 
    HTTP 
    DNS 
    FTP 
    WebSocket 
    SMTP 
    SNMP
)

# Component libraries
set(NetworkQuests_TCP_LIBRARY NetworkQuests::TCP)
set(NetworkQuests_UDP_LIBRARY NetworkQuests::UDP)
set(NetworkQuests_HTTP_LIBRARY NetworkQuests::HTTP)
set(NetworkQuests_DNS_LIBRARY NetworkQuests::DNS)
set(NetworkQuests_FTP_LIBRARY NetworkQuests::FTP)
set(NetworkQuests_WebSocket_LIBRARY NetworkQuests::WebSocket)
set(NetworkQuests_SMTP_LIBRARY NetworkQuests::SMTP)
set(NetworkQuests_SNMP_LIBRARY NetworkQuests::SNMP)

message(STATUS "Found NetworkQuests ${NetworkQuests_VERSION}")
message(STATUS "NetworkQuests protocols: ${NetworkQuests_PROTOCOLS}")

# Helper function to link specific protocols
function(networkquests_link_protocols target)
    cmake_parse_arguments(NQ "" "" "PROTOCOLS" ${ARGN})
    
    if(NOT NQ_PROTOCOLS)
        # Link all protocols if none specified
        target_link_libraries(${target} PRIVATE networkquests)
    else()
        # Link core utilities
        target_link_libraries(${target} PRIVATE NetworkQuests::Core)
        
        # Link specific protocols
        foreach(protocol ${NQ_PROTOCOLS})
            string(TOUPPER ${protocol} protocol_upper)
            if(${protocol_upper} IN_LIST NetworkQuests_PROTOCOLS)
                target_link_libraries(${target} PRIVATE NetworkQuests::${protocol_upper})
            else()
                message(WARNING "Unknown NetworkQuests protocol: ${protocol}")
            endif()
        endforeach()
    endif()
endfunction()